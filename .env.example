# Konfigurasi Environment Variable POS Sakopi Saroja (Tanpa Nilai Rahasia)
# Salin berkas ini menjadi `.env` untuk pengembangan lokal:
#   cp .env.example .env
# Untuk deployment produksi (Vercel / Netlify / Cloudflare Pages),
# gunakan fitur Environment Variables di dashboard hosting atau --dart-define.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
